import { useState } from "react"; import { Card, CardContent } from "@/components/ui/card"; import { Input } from "@/components/ui/input"; import { Button } from "@/components/ui/button";

const springOptions = [ { wireSize: 0.192, id: 1.75, length: 33, cycles: 10000 }, { wireSize: 0.207, id: 1.75, length: 32, cycles: 15000 }, { wireSize: 0.218, id: 2.0, length: 31, cycles: 20000 }, { wireSize: 0.225, id: 2.0, length: 29, cycles: 25000 }, { wireSize: 0.234, id: 2.0, length: 27, cycles: 30000 }, { wireSize: 0.243, id: 2.0, length: 25, cycles: 35000 } ];

export default function SpringTensionCalculator() { const [doorHeight, setDoorHeight] = useState(84); // inches const [doorWeight, setDoorWeight] = useState(150); // pounds const [drumDiameter, setDrumDiameter] = useState(4); // inches const [results, setResults] = useState(null);

const calculateTension = () => { const drumCircumference = Math.PI * drumDiameter; const turns = doorHeight / drumCircumference; const torqueRequired = doorWeight * (drumDiameter / 2); // inch-pounds

const recommendedSprings = springOptions
  .map((spring) => {
    const ippt = spring.wireSize * spring.id * 10; // simplified estimate
    const totalTorque = ippt * turns;
    const difference = Math.abs(totalTorque - torqueRequired);
    return { ...spring, ippt, totalTorque, difference };
  })
  .sort((a, b) => {
    // Prioritize cycle count, then closeness of torque match
    if (b.cycles === a.cycles) return a.difference - b.difference;
    return b.cycles - a.cycles;
  })
  .slice(0, 3); // Top 3 options

setResults({
  turns: turns.toFixed(2),
  torque: torqueRequired.toFixed(2),
  recommendedSprings
});

};

return ( <div className="max-w-xl mx-auto p-4 space-y-4"> <h1 className="text-2xl font-bold text-center">Garage Door Spring Tension Calculator</h1>

<Card>
    <CardContent className="space-y-4 p-4">
      <div>
        <label className="block mb-1 font-medium">Door Height (inches)</label>
        <Input
          type="number"
          value={doorHeight}
          onChange={(e) => setDoorHeight(Number(e.target.value))}
        />
      </div>

      <div>
        <label className="block mb-1 font-medium">Door Weight (lbs)</label>
        <Input
          type="number"
          value={doorWeight}
          onChange={(e) => setDoorWeight(Number(e.target.value))}
        />
      </div>

      <div>
        <label className="block mb-1 font-medium">Drum Diameter (inches)</label>
        <Input
          type="number"
          value={drumDiameter}
          onChange={(e) => setDrumDiameter(Number(e.target.value))}
        />
      </div>

      <Button onClick={calculateTension}>Calculate</Button>

      {results && (
        <div className="mt-4 space-y-2">
          <p><strong>Recommended Turns:</strong> {results.turns}</p>
          <p><strong>Required Torque:</strong> {results.torque} in-lbs</p>

          <div className="mt-4">
            <h2 className="font-semibold">Top Spring Options:</h2>
            <ul className="list-disc list-inside space-y-1">
              {results.recommendedSprings.map((spring, index) => (
                <li key={index}>
                  <strong>Wire:</strong> {spring.wireSize}" | <strong>ID:</strong> {spring.id}" | <strong>Length:</strong> {spring.length}" | <strong>Cycles:</strong> {spring.cycles}
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </CardContent>
  </Card>
</div>

); }

